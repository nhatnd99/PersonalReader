// ReadFlow – Prisma Schema
// Database: Neon PostgreSQL (free tier)
// ORM: Prisma 5

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Users ───────────────────────────────────────────────────────────────────
model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  passwordHash  String   @map("password_hash")
  displayName   String   @map("display_name")
  avatarUrl     String?  @map("avatar_url")
  isActive      Boolean  @default(true) @map("is_active")
  emailVerified Boolean  @default(false) @map("email_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  refreshTokens     RefreshToken[]
  books             Book[]
  uploadSessions    UploadSession[]
  importJobs        BookImportJob[]
  readingProgress   ReadingProgress[]
  readingPreference ReadingPreference?

  @@index([email])
  @@map("users")
}

// ─── Refresh Tokens (Token Rotation & Reuse Detection) ────────────────────────
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  family    String   @db.Uuid
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

// ─── Books ────────────────────────────────────────────────────────────────────
model Book {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  title            String
  author           String?
  description      String?
  originalFileName String    @map("original_file_name")
  coverImageUrl    String?   @map("cover_image_url")
  language         String?
  status           String    @default("pending") // Legacy/compatibility: "pending" | "ready" | "error" | "deleted"
  processingStatus String    @default("PENDING") @map("processing_status") // "PENDING" | "UPLOADING" | "PROCESSING" | "COMPLETED" | "FAILED" | "NEEDS_OCR" | "CANCELLED"
  pageCount        Int?      @map("page_count")
  totalPages       Int?      @map("total_pages")
  totalWords       Int?      @map("total_words")
  contentVersion   Int       @default(1) @map("content_version")
  tocVersion       Int       @default(1) @map("toc_version")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  files           BookFile[]
  uploadSessions  UploadSession[]
  contents        BookContent[]
  chapters        BookChapter[]
  importJobs      BookImportJob[]
  tocEntries      BookTableOfContents[]
  readingProgress ReadingProgress[]

  @@index([userId])
  @@index([status])
  @@index([processingStatus])
  @@index([userId, status, createdAt])
  @@map("books")
}

// ─── Book Contents (Ordered Sanitized HTML Chunks) ────────────────────────────
model BookContent {
  id              String   @id @default(uuid()) @db.Uuid
  bookId          String   @map("book_id") @db.Uuid
  sequence        Int
  contentHtml     String   @map("content_html") @db.Text
  plainText       String   @map("plain_text") @db.Text
  sourcePageStart Int      @map("source_page_start")
  sourcePageEnd   Int      @map("source_page_end")
  wordCount       Int      @map("word_count")
  createdAt       DateTime @default(now()) @map("created_at")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, sequence])
  @@index([bookId, sequence])
  @@map("book_contents")
}

// ─── Book Chapters (Detected Structural Navigation) ───────────────────────────
model BookChapter {
  id                   String @id @default(uuid()) @db.Uuid
  bookId               String @map("book_id") @db.Uuid
  title                String
  sequence             Int
  startContentSequence Int    @map("start_content_sequence")
  endContentSequence   Int    @map("end_content_sequence")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, sequence])
  @@index([bookId, sequence])
  @@map("book_chapters")
}

// ─── Book Import Jobs (In-Memory Processing Lifecycle) ────────────────────────
model BookImportJob {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  bookId       String?   @map("book_id") @db.Uuid
  status       String    @default("PENDING") // "PENDING" | "UPLOADING" | "PROCESSING" | "COMPLETED" | "FAILED" | "NEEDS_OCR" | "CANCELLED"
  progress     Int       @default(0)
  currentStep  String?   @map("current_step")
  errorMessage String?   @map("error_message")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  completedAt  DateTime? @map("completed_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book? @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookId])
  @@index([status])
  @@map("book_import_jobs")
}

// ─── Legacy Storage Models (Preserved for safe non-destructive schema history)
model BookFile {
  id               String   @id @default(uuid()) @db.Uuid
  bookId           String   @map("book_id") @db.Uuid
  storageProvider  String   @default("r2") @map("storage_provider")
  bucket           String
  objectKey        String   @unique @map("object_key")
  originalFileName String   @map("original_file_name")
  mimeType         String   @default("application/pdf") @map("mime_type")
  fileSize         Int      @map("file_size")
  checksum         String?
  uploadStatus     String   @default("completed") @map("upload_status")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([objectKey])
  @@map("book_files")
}

model UploadSession {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  bookId           String?  @map("book_id") @db.Uuid
  objectKey        String   @unique @map("object_key")
  originalFileName String   @map("original_file_name")
  mimeType         String   @default("application/pdf") @map("mime_type")
  expectedFileSize Int      @map("expected_file_size")
  status           String   @default("pending")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book? @relation(fields: [bookId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([objectKey])
  @@index([status])
  @@index([expiresAt])
  @@map("upload_sessions")
}

// ─── Book Table of Contents (Hybrid Auto + Manual Hierarchy) ─────────────────
model BookTableOfContents {
  id              String   @id @default(uuid()) @db.Uuid
  bookId          String   @map("book_id") @db.Uuid
  parentId        String?  @map("parent_id") @db.Uuid
  title           String
  anchorId        String   @map("anchor_id")
  contentBlockId  String?  @map("content_block_id")
  contentSequence Int      @default(1) @map("content_sequence")
  level           Int      @default(1) // 1..4
  position        Int      @default(0)
  sourceType      String   @default("AUTO") @map("source_type") // "AUTO" | "MANUAL"
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  book            Book                  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  parent          BookTableOfContents?  @relation("TocHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children        BookTableOfContents[] @relation("TocHierarchy")
  readingProgress ReadingProgress[]

  @@index([bookId, position])
  @@index([bookId, parentId])
  @@map("book_table_of_contents")
}

// ─── Reading Progress (Scroll + Logical Block & Sync Revision) ───────────────
model ReadingProgress {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  bookId            String   @map("book_id") @db.Uuid
  currentTocEntryId String?  @map("current_toc_entry_id") @db.Uuid
  currentBlockId    String?  @map("current_block_id")
  currentSequence   Int      @default(1) @map("current_sequence")
  scrollPercentage  Float    @default(0) @map("scroll_percentage")
  readingPercentage Float    @default(0) @map("reading_percentage")
  lastDeviceId      String?  @map("last_device_id")
  revision          Int      @default(1)
  lastReadAt        DateTime @default(now()) @map("last_read_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  book            Book                 @relation(fields: [bookId], references: [id], onDelete: Cascade)
  currentTocEntry BookTableOfContents? @relation(fields: [currentTocEntryId], references: [id], onDelete: SetNull)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@map("reading_progress")
}

// ─── Reading Preferences (Account-Level Reader Settings) ──────────────────────
model ReadingPreference {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  fontSize     Int      @default(18) @map("font_size")
  fontFamily   String   @default("serif") @map("font_family")
  lineHeight   Float    @default(1.75) @map("line_height")
  contentWidth Int      @default(720) @map("content_width")
  theme        String   @default("light") // "light" | "dark" | "sepia"
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reading_preferences")
}
