// ReadFlow – Prisma schema
// Database: Neon PostgreSQL (free tier)
// ORM: Prisma 5

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Users ───────────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String?  @map("display_name")
  storageUsed  BigInt   @default(0) @map("storage_used") // bytes
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  books       Book[]
  vocabulary  Vocabulary[]
  bookmarks   Bookmark[]
  highlights  Highlight[]
  notes       BookNote[]

  @@map("users")
}

// ─── Books ───────────────────────────────────────────────────────────────────
model Book {
  id          String     @id @default(cuid())
  userId      String     @map("user_id")
  title       String
  author      String?
  coverUrl    String?    @map("cover_url")
  status      BookStatus @default(PENDING)
  pageCount   Int?       @map("page_count")
  fileSize    BigInt?    @map("file_size") // bytes
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookFile        BookFile?
  uploadSession   UploadSession?
  readingProgress ReadingProgress?
  vocabulary      Vocabulary[]
  bookmarks       Bookmark[]
  highlights      Highlight[]
  notes           BookNote[]

  @@index([userId])
  @@map("books")
}

enum BookStatus {
  PENDING
  UPLOADING
  READY
  ERROR
}

// ─── Book Files (R2 PDF references) ──────────────────────────────────────────
model BookFile {
  id         String   @id @default(cuid())
  bookId     String   @unique @map("book_id")
  r2Key      String   @unique @map("r2_key") // object key in R2
  fileSize   BigInt   @map("file_size")
  mimeType   String   @default("application/pdf") @map("mime_type")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@map("book_files")
}

// ─── Upload Sessions ──────────────────────────────────────────────────────────
model UploadSession {
  id          String              @id @default(cuid())
  bookId      String              @unique @map("book_id")
  r2Key       String              @map("r2_key")
  status      UploadSessionStatus @default(PENDING)
  expiresAt   DateTime            @map("expires_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  completedAt DateTime?           @map("completed_at")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@map("upload_sessions")
}

enum UploadSessionStatus {
  PENDING
  COMPLETED
  EXPIRED
  FAILED
}

// ─── Reading Progress ─────────────────────────────────────────────────────────
model ReadingProgress {
  id          String   @id @default(cuid())
  bookId      String   @unique @map("book_id")
  userId      String   @map("user_id")
  currentPage Int      @default(1) @map("current_page")
  totalPages  Int?     @map("total_pages")
  percentage  Float    @default(0)
  version     Int      @default(1) // optimistic version for conflict resolution
  updatedAt   DateTime @updatedAt @map("updated_at")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("reading_progress")
}

// ─── Vocabulary ───────────────────────────────────────────────────────────────
model Vocabulary {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  bookId          String?  @map("book_id")
  word            String
  translation     String?
  definition      String?
  exampleSentence String?  @map("example_sentence")
  sourceContext   String?  @map("source_context") // surrounding paragraph
  pageNumber      Int?     @map("page_number")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book? @relation(fields: [bookId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([bookId])
  @@map("vocabulary")
}

// ─── Bookmarks ────────────────────────────────────────────────────────────────
model Bookmark {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  bookId     String   @map("book_id")
  pageNumber Int      @map("page_number")
  label      String?
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId, pageNumber])
  @@index([userId])
  @@index([bookId])
  @@map("bookmarks")
}

// ─── Highlights ───────────────────────────────────────────────────────────────
model Highlight {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  bookId       String   @map("book_id")
  pageNumber   Int      @map("page_number")
  selectedText String   @map("selected_text")
  color        String   @default("#FFEB3B")
  startOffset  Int?     @map("start_offset")
  endOffset    Int?     @map("end_offset")
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookId])
  @@map("highlights")
}

// ─── Book Notes ───────────────────────────────────────────────────────────────
model BookNote {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  bookId     String   @map("book_id")
  pageNumber Int?     @map("page_number")
  content    String
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookId])
  @@map("book_notes")
}
