# Copy this file to .env.local for local development.
# NEVER commit secrets to git.

# ─── Neon PostgreSQL ───────────────────────────────────────────────────────────
# Pooled connection (used by Prisma at runtime)
DATABASE_URL=postgresql://USER:PASS@ep-xxx.us-east-2.aws.neon.tech/readflow?sslmode=require&pgbouncer=true&connect_timeout=15

# Direct connection (used by Prisma migrate / db push)
DIRECT_URL=postgresql://USER:PASS@ep-xxx.us-east-2.aws.neon.tech/readflow?sslmode=require

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d

# ─── Cloudflare R2 (Private Bucket) ──────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=readflow-pdfs
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_REGION=auto
R2_PRESIGNED_URL_EXPIRES_IN=900

# ─── Gemini AI ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Frontend origin(s) allowed by CORS (comma-separated in production)
FRONTEND_ORIGINS=http://localhost:5173
# Max PDF upload size in bytes (default 50 MB)
MAX_PDF_SIZE_BYTES=52428800
# Max storage per user in bytes (default 500 MB)
MAX_USER_STORAGE_BYTES=524288000
